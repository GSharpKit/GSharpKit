#!/bin/bash

ARCH=`uname -p`
ARCH_NAME="arm64"
SUFFIX=
if [[ "$ARCH" == "arm" ]]; then
        ARCH="arm64"
else
        ARCH="x64"
	SUFFIX=86
fi

echo "Notarizing"
# App-specific password: https://appleid.apple.com/
# Store credential: xcrun notarytool store-credentials --apple-id "mikkel@xmedicus.com" --team-id GN4P8U89Y6
xcrun notarytool submit --wait --apple-id "mikkel@xmedicus.com" --keychain-profile "notarize$SUFFIX" --team-id GN4P8U89Y6 GSharpKit-@VERSION@-$ARCH.pkg

