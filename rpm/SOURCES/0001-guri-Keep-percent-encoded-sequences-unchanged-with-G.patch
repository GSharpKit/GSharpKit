From c7238a09ac58e484f2c34927d6f404fec66cc840 Mon Sep 17 00:00:00 2001
From: Mikkel Kruse Johnsen <mikkel@xmedicus.com>
Date: Mon, 16 Nov 2026 13:07:59 +0100
Subject: [PATCH] guri: Keep percent-encoded sequences unchanged with
 G_URI_FLAGS_ENCODED_*

With an ENCODED flag, uri_decoder() kept %-escapes but normalised them:
it uppercased the hex digits and decoded escaped unreserved characters,
so ?a=%2b%7e became ?a=%2B~.

libsoup parses request URIs with SOUP_HTTP_URI_FLAGS, which includes
G_URI_FLAGS_ENCODED_QUERY, so libsoup and WebKitGTK sent a different
query than the server issued in its Location header. That breaks
signatures computed over the encoded query: NemLog-in (Danish MitID)
rejects SAML HTTP-Redirect binding requests from an identity broker that
encodes with lowercase hex, while Firefox and Chrome send the bytes
unchanged and succeed.

Keep an existing %-sequence byte for byte. Illegal characters are still
escaped. The normalisation is equivalence-preserving (RFC 3986, section
6.2.2), so the tests now expect the escapes as written:

- /uri/normalize: http://foo/%aa stays %aa, and a new case checks that a
  signed-style query (%2b%2f%3d, %7e) survives unchanged.
- /uri/parsing/relative: g_uri_resolve_relative() works on the encoded
  form and now differs from g_uri_to_string() of the decoded parts for
  the case with escapes, so that case gets a separate expectation.
---
 glib/guri.c      |  12 ++---
 glib/tests/uri.c | 111 +++++++++++++++++++++++++----------------------
 2 files changed, 66 insertions(+), 57 deletions(-)

diff --git a/glib/guri.c b/glib/guri.c
index 8f7278d..cdc7139 100644
--- a/glib/guri.c
+++ b/glib/guri.c
@@ -327,12 +327,14 @@ uri_decoder (gchar       **out,
               g_string_free (decoded, TRUE);
               return -1;
             }
-          if (just_normalize && !g_uri_char_is_unreserved (c))
+          if (just_normalize)
             {
-              /* Leave the % sequence there but normalize it. */
-              g_string_append_c (decoded, *s);
-              g_string_append_c (decoded, g_ascii_toupper (s[1]));
-              g_string_append_c (decoded, g_ascii_toupper (s[2]));
+              /* Keep an existing % sequence byte for byte. Changing the case of the
+               * hex digits or decoding unreserved characters gives an equivalent URI
+               * (RFC 3986, section 6.2.2), but breaks signatures computed over the
+               * encoded query, such as the SAML HTTP-Redirect binding.
+               */
+              g_string_append_len (decoded, s, 3);
               s += 2;
             }
           else
diff --git a/glib/tests/uri.c b/glib/tests/uri.c
index e3b5dc7..8c256b9 100644
--- a/glib/tests/uri.c
+++ b/glib/tests/uri.c
@@ -824,113 +824,117 @@ test_uri_parsing_absolute (void)
 typedef struct {
   const gchar *orig, *resolved;
   UriParts parts;
+  /* Result of g_uri_resolve_relative() when it differs from @resolved: it keeps
+   * %-escapes as written, while g_uri_to_string() re-encodes decoded parts. */
+  const gchar *resolved_encoded;
 } UriRelativeTest;
 
